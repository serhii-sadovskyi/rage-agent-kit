{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/validate-plugin.sh",
            "statusMessage": "Validating the plugin manifest",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
