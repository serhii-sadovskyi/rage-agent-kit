#!/bin/sh
# Validate the plugin marketplace before a commit that changes it.
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# To commit without this check, use `git commit --no-verify`.

set -e

# Only run when the commit actually touches the plugin or the marketplace.
if ! git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^(plugins/|\.claude-plugin/)'; then
  exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "pre-commit: 'claude' is not on PATH, skipping plugin validation." >&2
  exit 0
fi

echo "pre-commit: claude plugin validate ."

if ! claude plugin validate .; then
  echo "pre-commit: validation failed, so the commit was stopped." >&2
  exit 1
fi
